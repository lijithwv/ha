                  "type": "picture-entity",
                  "entity": "camera.west_fluent_lens_1",
                  "image": "https://demo.home-assistant.io/stub_config/bedroom.png",
                  "name": " "
                },
                {
                  "show_state": true,
                  "show_name": false,
                  "camera_view": "live",
                  "fit_mode": "cover",
                  "type": "picture-entity",
                  "entity": "camera.west_fluent_lens_0",
                  "image": "https://demo.home-assistant.io/stub_config/bedroom.png"
                },
                {
                  "type": "heading",
                  "heading": "East",
                  "heading_style": "title"
                },
                {
                  "show_state": false,
                  "show_name": false,
                  "camera_view": "live",
                  "fit_mode": "fill",
                  "type": "picture-entity",
                  "entity": "camera.east_fluent",
                  "image": {
                    "media_content_id": "https://demo.home-assistant.io/stub_config/bedroom.png"
                  }
                },
                {
                  "type": "heading",
                  "heading": "Backyard",
