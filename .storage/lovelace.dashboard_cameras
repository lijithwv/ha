                  "fit_mode": "cover",
                  "type": "picture-entity",
                  "entity": "camera.backyard_fluent",
                  "image": "https://demo.home-assistant.io/stub_config/bedroom.png"
                }
              ],
              "column_span": 2
            }
          ],
          "type": "sections",
          "max_columns": 4,
          "cards": []
        }
      ]
    }
  }
}